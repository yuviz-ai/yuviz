# Real uploaded tenant documents (Knowledge Service storage) — user data,
# not source.
data/knowledge_documents/

# Tenant-namespaced raw credentials the Tool Execution Service resolves
# k8s: refs against locally (see scripts/start_local.sh's
# TOOLEXEC_TENANT_SECRET_ROOT) — live secrets, never source.
data/toolexec_tenant_secrets/

# The platform HMAC key TOOLEXEC_ARGS_HMAC_KEY_REF resolves against for
# side-effect claims and downstream idempotency keys. Generated locally on
# first run (see scripts/start_local.sh) — a live secret, never source.
data/toolexec_hmac_key

# Binary model weights — not source, and too large to version sensibly.
# silero_vad.onnx and the kokoro cache are fetched on first use / via a
# documented download step (see docs/setup.md) instead of being committed.
models/

# Claude Code config. The SDLC pipeline (agents, commands, lessons) is
# shared with the team; only per-developer state stays local.
.claude/settings.local.json
.claude/plans/
.claude/*.lock

# Excluded from the first push at user request.
samples/
docs/cloud_deployment_architecture.md
docs/transfer.md
docs/warm_transfer_architecture.md
.sdlc/current

# Locally-generated CA bundle (corporate TLS-interception root + certifi).
# Machine-specific and regenerable — see docs, never commit.
certs/
