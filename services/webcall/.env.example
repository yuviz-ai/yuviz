# Webcall bridge — copy to .env and fill in, or `export` these directly.
# See docs/setup.md for the full walkthrough.

# Optional — where the bridge connects for the actual STT/LLM/TTS
# pipeline. Defaults to Envoy's load-balanced gRPC proxy (:10000,
# matching config/envoy.yaml/config/gateway.yaml); scripts/start_web_test.sh
# overrides this to localhost:50051 directly since its simplified
# single-instance path doesn't run Envoy.
CONVERSATION_SVC_TARGET=localhost:10000

# Optional.
LOG_LEVEL=INFO
PORT=8300

# Required for ?draft=1 (admin text-chat against an unpublished graph).
# Must match Config Service's JWT_SECRET. Auth is a first WS frame, not ?token=.
# JWT_SECRET=

# Used to bind ?tenant= to the JWT (GET /tenants/{slug} — 404 on mismatch).
# CONFIG_SERVICE_URL=http://localhost:8000

# Optional — set to a directory to dump raw PCM audio for debugging; unset
# by default (no dump).
# WEBCALL_DUMP_AUDIO_DIR=
