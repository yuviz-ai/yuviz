# ./dev.sh copies this to .env and fills the secrets. No hand-editing needed.

POSTGRES_USER=voiceai
POSTGRES_PASSWORD=voiceai
POSTGRES_DB=voiceai
# Host is the compose service name — every consumer is a container.
POSTGRES_DSN=postgresql://voiceai:voiceai@postgres:5432/voiceai
REDIS_URL=redis://redis:6379/0

# RLS (database/rls.sql). YUVIZ_APP_PASSWORD sets the yuviz_app role's
# password when init.sh applies rls.sql. POSTGRES_APP_DSN/POSTGRES_ADMIN_DSN
# fall back to POSTGRES_DSN until the per-service DSN cutover — every
# service still connects as the superuser today, so RLS is live but inert.
YUVIZ_APP_PASSWORD=
POSTGRES_APP_DSN=
POSTGRES_ADMIN_DSN=

# Set by dev.sh from USE_HOST_OLLAMA.
OLLAMA_BASE_URL=http://ollama:11434

CONFIG_SERVICE_EMAIL=conversation-service@internal.yuviz.ai
CONFIG_SERVICE_PASSWORD=
JWT_SECRET=
# Fernet key (32 bytes, url-safe base64) — encrypts provider API keys at
# rest. Generated by dev.sh; without it the Admin UI can't accept one.
SECRET_ENCRYPTION_KEY=

# Loopback by default — default credentials, and no auth on redis/ollama.
BIND_ADDR=127.0.0.1

# Cloud provider keys, for api_key_ref='env:NAME' on a provider config. The
# conversation container's environment is an allow-list, so a key only
# reaches the service if it is also named in docker-compose.yml. Leave blank
# to paste keys in the Admin UI instead (stored encrypted, enc: scheme).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Read by both the conversation service and the seed; they must agree.
VOICEAI_STT_MODEL=small.en
# Ollama model for the seeded default agent. Written by dev.sh --llm-model;
# any tag from ollama.com/library works.
VOICEAI_LLM_MODEL=llama3.2
# Written by deployment/sh/dev.sh from --no-stt / --no-tts. 0 keeps that
# model out of Conversation Service's startup warm-up.
VOICEAI_ENABLE_STT=1
VOICEAI_ENABLE_TTS=1

# Host ports — change any that collide.
ADMIN_UI_PORT=3000
CONFIG_PORT=8000
KNOWLEDGE_PORT=8100
WEBCALL_PORT=8300
CONVERSATION_PORT=50051
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# Mirror for the spaCy model if github.com is unreachable. Rebuild after changing.
SPACY_MODEL_URL=
