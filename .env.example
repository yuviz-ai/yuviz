# Root-level env file for the native (non-Docker) local stack — loaded
# automatically by scripts/start_local.sh. Copy to .env and fill in real
# values; .env itself is gitignored, never commit the real values.
#
# (deployment/.env / .env.example is the separate, Docker-Compose-specific
# env file used by deployment/sh/dev.sh — not this one.)

# Fernet key for encrypting provider secrets at rest (see
# libs/config_sdk/secrets.py). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# HMAC signing key for Config Service JWTs (see services/config/auth.py).
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
