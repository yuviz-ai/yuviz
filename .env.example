# Yuviz — every setting for running the platform natively (scripts/start_local.sh).
#
# Copy to .env (start_local.sh does this on first run) and fill the blanks.
# .env is gitignored: real values live only there, never in code or YAML.
# Blank secrets marked "generated" are filled by start_local.sh on first run.
#
# Docker uses deployment/.env instead (generated by deployment/sh/dev.sh),
# because its hostnames are container names (postgres, redis, ...).

# ── Knowledge / RAG service ──────────────────────────────────────────────────
# The tuning knobs (deadlines, caps, limits, rerank, enrichment, re-embed ...) are listed with their defaults in
# docs/knowledge-env-vars.md (generated from the code). Left unset they use those defaults. The switch worth seeing here:
# PDF/Office parsing runs the parser in a same-user child process (see docs/knowledge-parser-sandbox.md): 0 = off (safe
# default; text, markdown, CSV and HTML always work), 1 = on, only with the contained worker deployment or a written
# acceptance of the risk.
KNOWLEDGE_BINARY_PARSERS=0

# ── Database and cache ───────────────────────────────────────────────────────
# Default: your macOS user on the local Postgres (start_local.sh fills it in).
POSTGRES_DSN=
# Admin connection for schema work; blank = POSTGRES_DSN.
POSTGRES_ADMIN_DSN=
# Row-level security role password, used when rls.sql is applied. Generated.
YUVIZ_APP_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── Platform secrets (generated) ─────────────────────────────────────────────
# Signs login tokens. Every service must share the same value.
JWT_SECRET=
# Fernet key that encrypts provider API keys at rest (enc: refs).
SECRET_ENCRYPTION_KEY=

# ── Service account Conversation uses to call Config ─────────────────────────
CONFIG_SERVICE_EMAIL=conversation-service@internal.yuviz.ai
# Generated; must match the account created by scripts/create_service_account.py.
CONFIG_SERVICE_PASSWORD=

# ── First superadmin (seeded only when none exists) ──────────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Service addresses (local defaults) ───────────────────────────────────────
# Address every native service listens on. Keep loopback: Config, Conversation
# and the rest trust their callers. Docker containers set 0.0.0.0 internally.
LISTEN_HOST=127.0.0.1
# Gateway WebSocket that FreeSWITCH streams audio to. Loopback when FreeSWITCH
# runs on this host; set this host's LAN IP only for the VM split
# (docs/telephony-vm-setup.md), and firewall it to the VM: it is unauthenticated.
GATEWAY_LISTEN_HOST=127.0.0.1
# Gateway WebSocket port; FreeSWITCH, crash-watch and smoke_test.py read it too.
GATEWAY_LISTEN_PORT=8080
# Each service listens on the port in its URL below, so callers and server never drift.
CONFIG_SERVICE_URL=http://localhost:8000
KNOWLEDGE_SERVICE_URL=http://localhost:8100
CAMPAIGNS_SERVICE_URL=http://localhost:8400
TOOLEXEC_SERVICE_URL=http://localhost:8600
TELEPHONY_SERVICE_URL=http://localhost:8750
CONVERSATION_SVC_TARGET=localhost:10000
CONVERSATION_SERVICE_GRPC=localhost:50051
ADMIN_UI_URL=http://localhost:3000
# Base of the links in invite emails; usually the Admin UI's public address.
INVITE_BASE_URL=http://localhost:3000
# Comma-separated CORS origins the REST services accept (blank = http://localhost:3000 only).
ADMIN_UI_ORIGINS=

# ── Telephony: FreeSWITCH, Kamailio, providers ───────────────────────────────
# FreeSWITCH Event Socket. Required: the Gateway and Campaigns refuse to run
# ESL without it. Must match event_socket.conf.xml's "password".
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8022
FREESWITCH_ESL_PASSWORD=
# SIP listen address: 127.0.0.1 (this Mac only), auto (LAN IP), or a fixed IPv4.
SIP_IP=127.0.0.1
# Leave blank: scripts/update_kamailio_ip.sh writes it.
SIP_PROXY_HOST=
SIP_PROXY_PORT=5060
# Kamailio's MySQL, e.g. mysql://kamailio:<password>@localhost/kamailio
KAMAILIO_DB_URL=
# Public URL (e.g. an ngrok tunnel) Vobiz/Cloudonix call back to.
TELEPHONY_PUBLIC_BASE_URL=
TELEPHONY_REFRESH_S=300
TELEPHONY_HEALTH_INTERVAL_S=300
TELEPHONY_ACCOUNT_LIMIT=300
TELEPHONY_DID_LIMIT=30
DID_REDIS_TIMEOUT_MS=250

# ── Email (invites, verification codes, password reset) ──────────────────────
# Gmail: smtp.gmail.com / 587 / you@gmail.com / an app password / STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_REF=env:SMTP_PASSWORD
SMTP_FROM=
SMTP_STARTTLS=true

# ── Google sign-in (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# ── AI provider keys, referenced by provider configs as env:NAME ─────────────
# Optional: keys pasted in the Admin UI are stored encrypted instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=

# ── Local models ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Conversation pipeline overrides (blank = built-in default) ──────────────
# 0 skips warming that model at startup (it loads on first use instead).
VOICEAI_ENABLE_STT=1
VOICEAI_ENABLE_TTS=1
# Only for agents without provider configs; normally set per agent in the UI.
VOICEAI_STT_MODEL=
VOICEAI_STT_DEVICE=
VOICEAI_STT_LANGUAGE=
# Multilingual agents: language-detector tuning (blank = code default).
# default 0.70 — min confidence to trust a language switch.
VOICEAI_LANG_MIN_CONFIDENCE=
# default 1 — consecutive turns in a new language before switching.
VOICEAI_LANG_SWITCH_STREAK=
# default 0.30 — share of Hindi words that counts a transcript as Hindi.
VOICEAI_LANG_HI_WORD_SHARE=
# default 0.45 — replies shorter than this many seconds are dropped; from here up to 1.0 s they must pass the confidence checks below.
VOICEAI_LANG_SHORT_MIN_S=
# default 0.80 — min language confidence for a 0.45-1.0 s utterance.
VOICEAI_LANG_SHORT_MIN_CONFIDENCE=
# default 0.0 — same, in a Hindi session (0 = decode and let Devanagari decide).
VOICEAI_LANG_SHORT_MIN_CONFIDENCE_HI=
# default 0.80 — min STT transcript confidence (Deepgram) for a 0.45-1.0 s utterance to count as speech.
VOICEAI_STT_SHORT_MIN_SPEECH_CONFIDENCE=
# Greeting and filler phrases kept as ready-made audio per voice (default 64).
VOICEAI_PHRASE_CACHE_ENTRIES=
VOICEAI_LLM_URL=
VOICEAI_LLM_MODEL=
VOICEAI_LLM_SYSTEM=
VOICEAI_LLM_TEMPERATURE=
VOICEAI_LLM_TIMEOUT=
VOICEAI_TTS_ENGINE=
VOICEAI_TTS_VOICE=
VOICEAI_TTS_LANG_CODE=
VOICEAI_TTS_KOKORO_SPEED=
VOICEAI_TTS_MACOS_WPM=
# Call sentiment scoring; the key falls back to OPENAI_API_KEY.
VOICEAI_SENTIMENT_URL=
VOICEAI_SENTIMENT_MODEL=
VOICEAI_SENTIMENT_API_KEY=
VOICEAI_SENTIMENT_TIMEOUT=
VOICEAI_SENTIMENT_DISABLED=
VOICEAI_SENTIMENT_MAX_TURNS=

# ── Knowledge base ───────────────────────────────────────────────────────────
KNOWLEDGE_STORAGE_ROOT=./data/knowledge_documents
# Max upload size in bytes (blank = 10 MiB default).
KNOWLEDGE_MAX_UPLOAD_BYTES=

# ── Custom API tools (toolexec) ──────────────────────────────────────────────
TOOLEXEC_TENANT_SECRET_ROOT=./data/toolexec_tenant_secrets
# Keys the idempotency hashes of tool-call arguments. Generated.
TOOLEXEC_ARGS_HMAC_KEY=
TOOLEXEC_ARGS_HMAC_KEY_REF=env:TOOLEXEC_ARGS_HMAC_KEY
# Key id stamped on stored hashes; blank = k1. Change it when rotating the key.
TOOLEXEC_ARGS_HMAC_KEY_ID=
TOOLEXEC_HTTP_HOST_ALLOWLIST=
TOOLEXEC_EXECUTE_SUBJECTS=conversation-service@internal.yuviz.ai
# host:port pairs that may resolve to a private address: platform services built to be called as
# custom APIs, i.e. the clinic service (localhost:8700 natively, clinic:8700 in compose). Exact
# host AND port; an http one also needs its host in TOOLEXEC_HTTP_HOST_ALLOWLIST.
TOOLEXEC_INTERNAL_ENDPOINTS=
# Service accounts allowed to write Google Calendar events through /internal/calendar.
TOOLEXEC_CALENDAR_SUBJECTS=clinic-service@internal.yuviz.ai
# Limits (blank = built-in default).
TOOLEXEC_MAX_CHAIN_BUDGET_MS=
TOOLEXEC_MAX_RESPONSE_BYTES=
TOOLEXEC_MAX_CONCURRENT_RUNS_PER_AGENT=
TOOLEXEC_MAX_RUNS_PER_MINUTE_PER_AGENT=
TOOLEXEC_SIDE_EFFECT_CLAIM_TTL=
# CRM/calendar connectors — set on the provider(s) you actually use.
# OAuth2 providers (google, microsoft, zoho, salesforce, hubspot) need their own
# app registered on that provider's console; CLIENT_SECRET_REF is a ref string
# (env:/k8s:/enc:), never a raw secret. REQUIRED_SCOPES is space-separated and
# only needed if the provider's console enforces scopes the install URL must request.
TOOLEXEC_OAUTH_REDIRECT_URI=
TOOLEXEC_OAUTH_GOOGLE_CLIENT_ID=
TOOLEXEC_OAUTH_GOOGLE_CLIENT_SECRET_REF=
TOOLEXEC_OAUTH_GOOGLE_REQUIRED_SCOPES=
TOOLEXEC_OAUTH_MICROSOFT_CLIENT_ID=
TOOLEXEC_OAUTH_MICROSOFT_CLIENT_SECRET_REF=
TOOLEXEC_OAUTH_MICROSOFT_REQUIRED_SCOPES=
TOOLEXEC_OAUTH_ZOHO_CLIENT_ID=
TOOLEXEC_OAUTH_ZOHO_CLIENT_SECRET_REF=
TOOLEXEC_OAUTH_ZOHO_REQUIRED_SCOPES=
TOOLEXEC_OAUTH_SALESFORCE_CLIENT_ID=
TOOLEXEC_OAUTH_SALESFORCE_CLIENT_SECRET_REF=
TOOLEXEC_OAUTH_SALESFORCE_REQUIRED_SCOPES=
TOOLEXEC_OAUTH_HUBSPOT_CLIENT_ID=
TOOLEXEC_OAUTH_HUBSPOT_CLIENT_SECRET_REF=
TOOLEXEC_OAUTH_HUBSPOT_REQUIRED_SCOPES=
# cal.com is an API-key connector (no OAuth app), gated by its own flag.
TOOLEXEC_CALCOM_ENABLED=

# ── Admin UI (read at build/dev time) ────────────────────────────────────────
NEXT_PUBLIC_CONFIG_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_KNOWLEDGE_SERVICE_URL=http://localhost:8100
NEXT_PUBLIC_CAMPAIGNS_SERVICE_URL=http://localhost:8400
NEXT_PUBLIC_TOOLEXEC_SERVICE_URL=http://localhost:8600
NEXT_PUBLIC_DID_SERVICE_URL=http://localhost:8200
NEXT_PUBLIC_WEBCALL_URL=ws://localhost:8300
NEXT_PUBLIC_VOBIZ_SERVICE_URL=
NEXT_PUBLIC_CLOUDONIX_SERVICE_URL=

# ── Debugging (leave blank) ──────────────────────────────────────────────────
LOG_LEVEL=INFO
MEDIA_STREAM_DUMP_DIR=
WEBCALL_DUMP_AUDIO_DIR=

# ── Clinic appointments (services/clinic) ────────────────────────────────────
CLINIC_SERVICE_URL=http://localhost:8700
# The clinic's service account (scripts/create_service_account.py), used to ask toolexec to
# mirror appointments into Google Calendar. Must be listed in TOOLEXEC_CALENDAR_SUBJECTS.
CLINIC_SERVICE_EMAIL=clinic-service@internal.yuviz.ai
CLINIC_SERVICE_PASSWORD=
# Reminder calls: the SIP proxy FreeSWITCH sends the patient leg to (host:port), and how the
# carrier wants numbers dialled: national0 (09876543210), national (9876543210) or e164.
CLINIC_REMINDER_SIP_GATEWAY=
CLINIC_DIAL_FORMAT=national0
# FreeSWITCH sofia profile for the patient leg; use one whose SDP advertises an address the carrier
# can reach (a STUN public IP towards a private-network carrier means one-way audio).
CLINIC_REMINDER_SIP_PROFILE=external
# 0 runs the API without the outbox (SMS/calendar) and reminder workers.
CLINIC_WORKERS=1
# IANA timezone for the agent's "today" and "tomorrow" (blank = UTC), e.g. Asia/Kolkata.
VOICEAI_BUSINESS_TIMEZONE=
# Say a filler ("one moment") only after this much silence while a tool runs or the first reply
# is generated; a faster answer gets none (blank = 1200; 0 = always, immediately).
VOICEAI_FILLER_DELAY_MS=
# Search the agent's knowledge base up front when the caller's words look like a question the documents
# answer, so the model replies in one pass instead of calling search_knowledge and then answering
# (blank or 1 = on; 0/off = the model always calls the tool itself). Only agents with a knowledge base search.
VOICEAI_PRE_RETRIEVAL=
# The longest a turn waits for that search before starting the model without it (blank = 250). A late or
# failed search only means the model falls back to calling search_knowledge itself.
VOICEAI_PRE_RETRIEVAL_WAIT_MS=
# Deepgram regional endpoint for live speech-to-text (blank = api.deepgram.com). From India use
# api.in.deepgram.com: ~50 ms per round trip instead of ~260 ms to the US.
DEEPGRAM_API_HOST=
# Sarvam AI (Bulbul) text-to-speech for Indian languages; a provider row points at it as env:SARVAM_API_KEY.
SARVAM_API_KEY=
